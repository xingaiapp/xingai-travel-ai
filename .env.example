# XingAI Travel AI — Environment Variables
# Copy this file to .env.local and fill in your values

# ── AI ──────────────────────────────────────────────────────────────
# OpenAI API key (required for live recommendations)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model override (optional — defaults to gpt-4o-mini)
# Use gpt-4o for higher quality, gpt-4o-mini for lower cost
OPENAI_TRAVEL_MODEL=gpt-4o-mini

# Demo rate limit per IP per day (0 = unlimited for local dev, 3 = production default)
# Set to 0 in .env.local for unlimited local testing
# Set to 3 (or omit) in Vercel production env
TRAVEL_DEMO_DAILY_LIMIT=0

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://travel.xingai.app

# ── Affiliate IDs (optional — links work without, just no commission) ──
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
NEXT_PUBLIC_SKYSCANNER_PARTNER_ID=
NEXT_PUBLIC_EXPEDIA_CID=
NEXT_PUBLIC_VIATOR_PARTNER_ID=
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
